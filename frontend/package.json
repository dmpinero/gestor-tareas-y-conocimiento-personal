    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "marked": "^18.1.3",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
