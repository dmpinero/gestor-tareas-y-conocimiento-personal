server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolver dinamico: con un host fijo en proxy_pass, nginx lo resuelve
    # UNA SOLA VEZ al arrancar y, si en ese instante el backend aun no esta
    # listo (p. ej. en Railway, antes de que su red privada propague el
    # registro DNS del otro servicio), nginx se niega a arrancar y no
    # vuelve a intentarlo solo. Usando una variable en proxy_pass, nginx
    # resuelve por peticion (con el "resolver" de abajo) y reintenta solo
    # cuando el backend tarda en estar disponible.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # El alta de oportunidades la sirve el servicio "automatizador" (Playwright),
    # no el backend. Al ser el prefijo mas largo, nginx lo elige antes que
    # /api/v1/. Si ese servicio no existe (p. ej. en Railway), solo esta ruta
    # responde 502; el resto de la API no se ve afectada.
    location /api/v1/alta-oportunidades {
        set $automatizador ${URL_AUTOMATIZADOR};
        proxy_pass $automatizador;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Subida de imagenes de los comentarios: la API admite hasta 5 MB por
    # imagen (y responde 413 con su mensaje si pasa); el limite por defecto
    # de nginx (1 MB) las cortaria antes. Se deja 1 MB de margen para el
    # resto del multipart. Solo esta ruta; el resto de la API sigue con 1 MB.
    location = /api/v1/imagenes {
        client_max_body_size 6m;
        set $backend ${URL_BACKEND};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/v1/ {
        # Con una variable en proxy_pass, nginx ignora la parte de ruta del
        # destino para el reemplazo del prefijo de location y reenvia la URI
        # original tal cual (ver docs de proxy_pass); como ya coincide con
        # las rutas reales del backend, no hay que repetir "/api/v1/" aqui.
        set $backend ${URL_BACKEND};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
